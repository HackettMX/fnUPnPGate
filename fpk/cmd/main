#!/bin/bash
# Docker 应用的启停由应用中心通过 docker-project 资源统一管理，
# 这里 start/stop 保持幂等返回 0，status 通过健康检查端点判断服务是否在运行。
case "$1" in
  start)
    exit 0
    ;;

  stop)
    exit 0
    ;;

  status)
    if curl -sf -m 3 "http://127.0.0.1:8090/api/health" >/dev/null 2>&1; then
      exit 0
    fi
    exit 3
    ;;

  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    exit 1
    ;;
esac
